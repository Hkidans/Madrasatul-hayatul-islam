rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function role(){return signedIn()?get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role:null;}
  function admin(){return signedIn()&&role()=="admin";}
  function registrationOfficer(){return signedIn()&&role()=="registration_officer";}
  function examOfficer(){return signedIn()&&role()=="exam_officer";}
  function student(){return signedIn()&&role()=="student";}
  match /users/{id}{allow read: if signedIn()&&(request.auth.uid==id||admin());allow create,update,delete: if admin();}
  match /students/{id}{allow read: if admin()||registrationOfficer()||examOfficer()||(student()&&(resource.data.uid==request.auth.uid));allow create,update: if admin()||registrationOfficer();allow delete: if admin();}
  match /exams/{id}{allow read,create,update,delete: if admin()||examOfficer();}
  match /results/{id}{allow read,create,update,delete: if admin()||examOfficer()||(student()&&resource.data.studentUid==request.auth.uid);}
  match /announcements/{id}{allow read: if true;allow create,update,delete: if admin();}
  match /attendance/{id}{allow read: if admin()||(student()&&resource.data.uid==request.auth.uid);allow create,update,delete: if admin();}
 }
}
